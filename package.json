{
  "name": "react-echarts-library",
  "version": "1.4.0",
  "description": "A modern React wrapper for Apache ECharts with TypeScript support, hooks, and full React 18/19 compatibility",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "echarts",
    "charts",
    "visualization",
    "react-component",
    "typescript",
    "data-visualization",
    "tree-shaking"
  ],
  "author": "Yerzhan Sagyt",
  "license": "MIT",
  "peerDependencies": {
    "echarts": "^5.4.0 || ^6.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.3.0",
    "@storybook/react": "^10.3.0",
    "@storybook/react-vite": "^10.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "echarts": "^6.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.4.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^10.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "vitest-canvas-mock": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yerzhansa/react-echarts-library.git"
  },
  "homepage": "https://github.com/yerzhansa/react-echarts-library",
  "bugs": {
    "url": "https://github.com/yerzhansa/react-echarts-library/issues"
  }
}
